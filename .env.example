# 环境配置示例
# 复制此文件为 .env.local 并根据需要修改

# 环境标识
NODE_ENV=development

# Supabase 配置（可选，用于登录、个人中心、喜欢 / 收藏与统计功能）
# VITE_SUPABASE_URL=your-supabase-url
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 缩略图和预览图入口，默认走本站 /images（Cloudflare Pages Function / 本地 Vite 中间件）
# 只支持本站 /images 或 HTTPS 自有域名的完整 /images 入口（末尾斜杠可省略）
# 入口后拼接 /{tag}/{thumbnail|preview}/{series}/{path}，自有域名也需部署相同网关
# 裸域名、其他路径前缀、HTTP、凭证、查询参数和不明协议都会回退本站 /images
# VITE_IMAGE_BASE_URL=https://images.example.com/images
# VITE_IMAGE_BASE_URL=/images
# 不部署图片服务时可显式禁用，使用原来的 jsDelivr + GitHub Raw 同尺寸回退
# VITE_IMAGE_PROXY_ENABLED=false
# 未启用下载保护时，原图和下载仍走 jsDelivr / Raw；Bing 与动态壁纸使用独立图源

# 仅本地执行 `pnpm sync:assets` 时需要，千万不要暴露到前端
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 数据来源说明：
# 所有数据统一从线上图床 CDN 拉取
# 运行 npm run sync 即可自动下载最新数据
# CDN 地址: https://wallpaper.061129.xyz/data

# 下载入口保护：必须先配置私有Worker、Turnstile secrets和Pages DOWNLOAD_GUARD绑定
# 默认关闭；开启后缺失服务会拒绝下载，不会跳过验证。Worker 配置见 workers/download-guard/wrangler.jsonc
# VITE_DOWNLOAD_PROTECTION_ENABLED=false
