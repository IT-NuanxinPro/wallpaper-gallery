{
  "name": "wallpaper-download-guard",
  "main": "index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DOWNLOAD_HOSTNAMES": "wallpaper.061129.xyz",
    "TURNSTILE_SITE_KEY": ""
  },
  "ratelimits": [
    { "name": "REQUEST_RATE", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "FREE_DOWNLOADS", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "MAX_DOWNLOADS", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "FILE_DOWNLOADS", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ]
}
